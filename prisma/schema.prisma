generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  GOOGLE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  WALK_IN
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum EnquirySource {
  WEBSITE
  APPOINTMENT
  WHATSAPP
  PHONE
  GOOGLE
  INSTAGRAM
  FACEBOOK
  REFERRAL
  OTHER
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

enum NotificationType {
  NEW_APPOINTMENT
  NEW_LEAD
  NEW_ENQUIRY
  APPOINTMENT_CANCELLED
  NEW_PATIENT
}

enum BranchStatus {
  ACTIVE
  CLOSED
}

model Admin {
  id              String    @id @default(cuid())
  loginId         String    @unique
  name            String
  email           String?   @unique
  phone           String?
  profilePhotoUrl String?
  passwordHash    String
  role            AdminRole @default(RECEPTIONIST)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  permissions     Json?
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  activityLogs    AdminActivityLog[]

  @@index([role])
  @@index([branchId])
  @@index([active])
}

model AdminActivityLog {
  id          String   @id @default(cuid())
  adminId     String?
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName   String
  action      String
  entityType  String?
  entityId    String?
  entityLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

model Patient {
  id             String        @id @default(cuid())
  patientCode    String        @unique
  name           String
  phone          String
  email          String?
  gender         String?
  dateOfBirth    DateTime?
  address        String?
  medicalNotes   String?
  treatmentHistory String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  enquiries      Enquiry[]
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
}

model Service {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  description       String
  shortDesc         String?
  whatIsTreatment   String?
  image             String?
  icon              String?
  categoryId        String?
  category          ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  treatmentDuration String?
  price             Decimal?         @db.Decimal(10, 2)
  hidePrice         Boolean          @default(false)
  benefits          Json             @default("[]")
  treatmentSteps    Json             @default("[]")
  faqs              Json             @default("[]")
  featured          Boolean          @default(false)
  enabled           Boolean          @default(true)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  appointments      Appointment[]
}

model Doctor {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  qualification      String
  specialization     String
  experienceYears    Int
  bio                String
  summary            String?
  areasOfExpertise   Json          @default("[]")
  languagesSpoken    String?
  weeklySchedule     Json?
  registrationNumber String?
  phone              String?
  image              String?
  consultationHours  String?
  featured           Boolean       @default(false)
  enabled            Boolean       @default(true)
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[]
}

model Appointment {
  id              String            @id @default(cuid())
  appointmentCode String            @unique
  patientId       String?
  patient         Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName     String
  phone           String
  email           String?
  branchId        String?
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctorId        String?
  doctor          Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  treatmentName   String
  appointmentDate DateTime
  appointmentTime String
  message         String?
  notes           String?
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([appointmentDate])
  @@index([status])
  @@index([createdAt])
  @@index([doctorId, appointmentDate, appointmentTime])
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  phone           String
  email           String?
  source          LeadSource @default(WEBSITE)
  interestedService String?
  status          LeadStatus @default(NEW)
  followUpDate    DateTime?
  notes           String?
  assignedStaff   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Testimonial {
  id              String        @id @default(cuid())
  patientName     String
  patientImage    String?
  rating          Int           @default(5)
  testimonial     String
  treatment       String?
  testimonialDate DateTime      @default(now())
  verifiedPatient Boolean       @default(true)
  status          PublishStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Media {
  id              String        @id @default(cuid())
  title           String
  description     String?
  mediaType       MediaType
  mediaUrl        String
  thumbnailUrl    String?
  durationSeconds Int?
  viewCount       Int           @default(0)
  category        String        @default("clinic")
  isPublic        Boolean       @default(false)
  status          PublishStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BeforeAfter {
  id                String        @id @default(cuid())
  caseName          String        @default("Clinical case")
  treatment         String
  category          String        @default("cosmetic-dentistry")
  beforeImage       String
  afterImage        String
  description       String?
  treatmentDuration String?
  caseDate          DateTime      @default(now())
  verifiedCase      Boolean       @default(true)
  consentConfirmed  Boolean       @default(false)
  isPublic          Boolean       @default(false)
  featured          Boolean       @default(false)
  status            PublishStatus @default(DRAFT)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Enquiry {
  id            String         @id @default(cuid())
  name          String
  phone         String
  email         String?
  subject       String         @default("General enquiry")
  message       String
  source        EnquirySource  @default(WEBSITE)
  status        EnquiryStatus  @default(NEW)
  important     Boolean        @default(false)
  assignedStaff String?
  patientId     String?
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  conversation  Json           @default("[]")
  auditLog      Json           @default("[]")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([assignedStaff])
  @@index([important])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  subject   String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([read, createdAt])
}

model HeroStat {
  id        String   @id @default(cuid())
  label     String
  value     String
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  image          String?
  address        String
  city           String
  state          String?
  pinCode        String?
  location       String?
  phone          String
  whatsapp       String?
  mapUrl         String?
  mapEmbedUrl    String?
  latitude       String?
  longitude      String?
  weeklySchedule Json?
  openTime       String
  closeTime      String
  offDays        String?
  doctorIds      Json           @default("[]")
  serviceIds     Json           @default("[]")
  featured       Boolean        @default(false)
  published      Boolean        @default(true)
  status         BranchStatus   @default(ACTIVE)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appointments   Appointment[]
  admins         Admin[]
}

model ClinicSettings {
  id                 String   @id @default("default")
  clinicName         String   @default("Shiv Dental Clinic")
  tagline            String?
  logoUrl            String?
  faviconUrl         String?
  phone              String   @default("+91 98765 43210")
  whatsapp           String   @default("+91 98765 43210")
  email              String   @default("info@shivdentalclinic.com")
  address            String   @default("123 Health Street, Medical District, Mumbai, India")
  city               String?
  state              String?
  pinCode            String?
  mapEmbedUrl        String?
  mapLink            String?
  googleBusinessUrl  String?
  openingHours       Json?
  socialLinks        Json?
  emergencyContact   String?
  footerText         String?
  aboutIntro         String?
  mission            String?
  vision             String?
  whyChooseUs        String?
  aboutImages        Json?
  seoTitle           String?
  seoDescription     String?
  defaultLanguage    String   @default("en")
  timezone           String   @default("Asia/Kolkata")
  currency           String   @default("INR")
  extendedSettings   Json     @default("{}")
  secrets            Json     @default("{}")
  showRevenueCard    Boolean  @default(false)
  monthlyRevenue     Decimal? @db.Decimal(12, 2)
  updatedAt          DateTime @updatedAt
}
