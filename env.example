# AWS RDS PostgreSQL (Writer endpoint)
DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@database-1.cluster-c5mm0sc887f3.ap-south-1.rds.amazonaws.com:5432/shiv-dental-clinic?schema=public&sslmode=require"
# Set to true to use AWS RDS IAM auth (password in DATABASE_URL is ignored; IAM DB user must match URL username)
DATABASE_IAM_AUTH=false

AUTH_SECRET="generate-a-long-random-secret-here"

ADMIN_EMAIL="admin@shivdentalclinic.com"
ADMIN_PASSWORD="Admin@123"

AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_S3_PUBLIC_URL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Pages / Workers: add DATABASE_URL + AUTH_SECRET in
# Project Settings → Environment variables for Production AND Build.
