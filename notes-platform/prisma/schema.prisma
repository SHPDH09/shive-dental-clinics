generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STUDENT
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum NoteStatus {
  ACTIVE
  DISABLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  DISABLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         UserRole
  profileImage String?
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  adminProfile AdminProfile?
  cartItems    CartItem[]
  orders       Order[]
  purchases    Purchase[]
  transactions Transaction[]
  couponUsages CouponUsage[]

  @@index([role])
  @@index([status])
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id            String       @id @default(cuid())
  name          String
  coverImage    String?
  title         String
  description   String       @db.Text
  pdfPath       String?
  notesLink     String?
  price         Decimal      @db.Decimal(12, 2)
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)
  finalPrice    Decimal      @db.Decimal(12, 2)
  status        NoteStatus   @default(ACTIVE)
  viewCount     Int          @default(0)
  purchaseCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
  purchases   Purchase[]
  couponNotes CouponNote[]

  @@index([status])
  @@index([createdAt])
  @@index([finalPrice])
}

model Coupon {
  id                  String         @id @default(cuid())
  code                String         @unique
  discountType        DiscountType
  discountValue       Decimal        @db.Decimal(12, 2)
  maxUsers            Int?
  usedCount           Int            @default(0)
  validFrom           DateTime
  validUntil          DateTime
  minPurchaseAmount   Decimal        @default(0) @db.Decimal(12, 2)
  maxDiscount         Decimal?       @db.Decimal(12, 2)
  status              CouponStatus   @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  couponNotes CouponNote[]
  orders      Order[]
  usages      CouponUsage[]

  @@index([status])
  @@index([validUntil])
}

model CouponNote {
  couponId String
  noteId   String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([couponId, noteId])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  usedAt    DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  noteId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, noteId])
  @@index([userId])
}

model Order {
  id                String            @id @default(cuid())
  userId            String
  subtotal          Decimal           @db.Decimal(12, 2)
  discount          Decimal           @default(0) @db.Decimal(12, 2)
  couponDiscount    Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  couponId          String?
  paymentStatus     PaymentStatus     @default(PENDING)
  transactionStatus TransactionStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  transactions Transaction[]
  purchases    Purchase[]
  couponUsages CouponUsage[]

  @@index([userId])
  @@index([paymentStatus])
  @@index([transactionStatus])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  noteId     String
  price      Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  finalPrice Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  note  Note  @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([noteId])
}

model Transaction {
  id              String        @id @default(cuid())
  orderId         String
  userId          String
  externalId      String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  createdAt       DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  noteId          String
  orderId         String
  purchasedPrice  Decimal  @db.Decimal(12, 2)
  purchasedAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note  Note  @relation(fields: [noteId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([userId])
  @@index([noteId])
}
