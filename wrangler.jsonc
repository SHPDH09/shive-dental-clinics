{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shive-dental-clinics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "AUTH_URL": "https://shive-dental-clinics.shivedentalclinic-com.workers.dev",
    "NEXTAUTH_URL": "https://shive-dental-clinics.shivedentalclinic-com.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://shive-dental-clinics.shivedentalclinic-com.workers.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
